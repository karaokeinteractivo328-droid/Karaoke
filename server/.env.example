# Copiar a .env (no se sube a git) o setear estas mismas variables en el
# dashboard de Render. Sin esto, todo sigue funcionando igual salvo que no
# se guardan puntajes/reacciones ni aparece el leaderboard.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Solo hace falta en produccion (deploy separado Vercel+Render). En local
# se resuelven solos por la IP de la red wifi, no tocar.
PUBLIC_FRONTEND_URL=
PUBLIC_BACKEND_URL=
