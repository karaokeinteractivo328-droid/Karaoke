---
import Base from '../layouts/Base.astro';
---

<Base title="Karaoke · Pantalla principal">
  <div id="bg">
    <div class="halftone h1"></div>
    <div class="halftone h2"></div>
    <div class="halftone h3"></div>
  </div>
  <video id="selfCam" autoplay playsinline muted></video>
  <canvas id="camara"></canvas>
  <div id="velo"></div>
  <div id="estrella-wrap"></div>
  <div id="tinte"></div>
  <div id="grano"></div>
  <audio id="pista" preload="auto"></audio>

  <header id="marca">karaoke <span>studio</span></header>
  <div id="vozBox">🎙️ <span id="vozStatus">iniciando…</span></div>
  <div id="gestoHUD" hidden>✋ <span id="gestoTxt"></span></div>
  <div id="feedbackFlash"></div>

  <!-- ESPERANDO -->
  <section class="ui" data-estado="ESPERANDO">
    <p class="kicker">Sentite un cantante profesional</p>
    <h1 class="cartel">Viví tu<br>era <span class="script">popstar</span></h1>
    <p class="hint">Levantá la mano o decí "cantar"</p>
  </section>

  <!-- MODO: solo o dúo -->
  <section class="ui" data-estado="MODO">
    <p class="kicker">¿Cómo cantás?</p>
    <div id="modoSel">
      <div class="opc" data-opc="solo">
        <span class="op-icono">🙋</span>
        <span class="op-txt">SOLO</span>
      </div>
      <div class="opc" data-opc="duo">
        <span class="op-icono">🙌</span>
        <span class="op-txt">DÚO</span>
        <span class="op-sub">competencia</span>
      </div>
    </div>
    <p class="hint">1 mano = solo · 2 manos = dúo · o decilo · mantené para elegir</p>
  </section>

  <!-- SELECCIONANDO -->
  <section class="ui" data-estado="SELECCIONANDO">
    <p class="kicker">Elegí</p>
    <h2 class="cartel">Tu canción</h2>
    <ul id="lista"></ul>
    <p class="hint">Mano arriba / abajo o decí el nombre · pellizcá para confirmar</p>
  </section>

  <!-- CONFIRMADA -->
  <section class="ui" data-estado="CONFIRMADA">
    <h2 class="cartel">Preparate</h2>
    <p class="lead" id="confTitulo"></p>
  </section>

  <!-- COUNTDOWN -->
  <section class="ui" data-estado="COUNTDOWN">
    <div id="cuenta">3</div>
  </section>

  <!-- PLAYING -->
  <section class="ui" data-estado="PLAYING">
    <div id="letra">
      <p id="lineaActual"></p>
      <p id="lineaSiguiente"></p>
    </div>
    <div id="reto" hidden>
      <span id="retoIcono"></span>
      <span id="retoTexto"></span>
      <span class="reto-barra"></span>
    </div>
  </section>
  <div id="progreso" hidden><span></span></div>

  <!-- RESULTADO -->
  <section class="ui" data-estado="RESULTADO">
    <h1 class="cartel">Un éxito, <span class="script">popstar</span></h1>
    <div id="resultadoRow">
      <div id="score">0</div>
      <div id="qrMarco"><img id="qrResultado" alt="QR para descargar tu video" /></div>
    </div>
    <a id="bajarVideo" hidden download="mi-karaoke.webm">↓ descargar mi video</a>
    <p class="hint">Escaneá el QR para llevarte tu video</p>
  </section>

  <script>
    import '../lib/pantalla.js';
  </script>
</Base>
