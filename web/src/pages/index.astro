---
import Base from '../layouts/Base.astro';
---

<Base title="Karaoke · Pantalla principal">
  <div id="bg">
    <div class="halftone h1"></div>
    <div class="halftone h2"></div>
    <div class="halftone h3"></div>
  </div>
  <video id="selfCam" autoplay playsinline muted></video>
  <canvas id="camara"></canvas>
  <div id="velo"></div>
  <div id="estrella-wrap"></div>
  <div id="tinte"></div>
  <div id="grano"></div>
  <audio id="pista" preload="auto"></audio>

  <!-- Sin sonido no hay karaoke: el navegador exige un toque para habilitarlo (o el modo kiosco) -->
  <div id="sonidoOverlay" hidden>
    <div>
      <b>🔊</b>
      <p>Tocá la pantalla para activar el sonido</p>
      <small>Sin esto la música no se escucha</small>
    </div>
  </div>

  <header id="marca">karaoke <span>studio</span></header>

  <!-- salud de la instalación: solo aparece si algo falla -->
  <div id="chips">
    <span class="chip" id="chipCamara" hidden>📷 sin cámara</span>
    <span class="chip" id="chipManos" hidden>🖐️ sin detección de manos (retos con gestos desactivados)</span>
    <span class="chip" id="chipSilencio" hidden>🔇 sin sonido</span>
    <span class="chip" id="chipMic" hidden>🎙️ sin micrófono</span>
    <button class="chip" id="chipAudio" hidden>🔇 tocá la pantalla para activar el sonido</button>
    <span class="chip" id="chipEspejo" hidden>🪞 pantalla espejo (otra pantalla tiene el control)</span>
    <span class="chip" id="chipSinServer" hidden>📡 reconectando…</span>
  </div>

  <div id="feedbackFlash"></div>
  <!-- "✓ ¡LO HICISTE! +10 PUNTOS": por que se ganó el punto -->
  <div id="retoFeedback" hidden><b id="retoFeedbackTitulo"></b><span id="retoFeedbackPuntos"></span></div>
  <div id="reacciones-vuelan"></div>

  <!-- quién canta ahora + reacciones (solo durante la performance) -->
  <div id="cantandoAhora" hidden>🎤 <span id="cantandoNombre"></span><span id="reaccionesContador" hidden></span></div>

  <!-- el único dato de la fila que vive en la pantalla grande -->
  <div id="siguiente" hidden>
    <span class="kicker">sigue</span>
    <b id="siguienteNombre"></b>
    <small id="siguienteMas"></small>
  </div>

  <!-- QR GENERAL de la sala: siempre a la vista (menos en STANDBY, donde ya es grande).
       No es el QR del video de cada persona (ese solo aparece en RESULT). -->
  <aside id="qrFijo" aria-label="QR para sumarte a la sala">
    <img id="qrFijoImg" alt="QR para sumarte" />
    <span>UNITE</span>
  </aside>

  <!-- STANDBY: nadie cantando ni esperando -->
  <section class="ui" data-estado="STANDBY">
    <p class="kicker">Sentite un cantante profesional</p>
    <h1 class="cartel">Viví tu<br>era <span class="script">popstar</span></h1>
    <div id="qrBox" class="tarjetaQR">
      <img id="qrSala" alt="QR para participar desde el celular" />
      <p class="qrTitulo">Escaneá el QR para participar</p>
      <p class="hint" id="qrUrl"></p>
    </div>
    <div id="topNoche" hidden>
      <p class="kicker">los mejores de la noche</p>
      <ol id="topNocheLista"></ol>
    </div>
  </section>

  <!-- CALLING: se llamó al siguiente -->
  <section class="ui" data-estado="CALLING">
    <p class="kicker">Turno de</p>
    <h2 class="cartel" id="turnoNombre">Nombre</h2>
    <p class="kicker" id="turnoModo" hidden></p>
    <p id="turnoCancion"></p>
    <p class="hint" id="turnoFase"></p>
    <div id="turnoBarra"><span></span></div>
  </section>

  <!-- COUNTDOWN -->
  <section class="ui" data-estado="COUNTDOWN">
    <div id="cuenta">3</div>
  </section>

  <!-- PLAYING: prioridad absoluta al cantante -->
  <section class="ui" data-estado="PLAYING">
    <div id="letra">
      <p id="lineaActual"></p>
      <p id="lineaSiguiente"></p>
    </div>
    <div id="reto" hidden>
      <div class="reto-fila">
        <span id="retoIcono"></span>
        <span id="retoTexto"></span>
        <b id="retoPuntos"></b>
      </div>
      <div id="retoOpciones" hidden></div>
      <p id="retoAyuda" hidden></p>
      <span class="reto-barra"></span>
      <span class="reto-sostener"></span>
    </div>
  </section>
  <div id="progreso" hidden><span></span></div>

  <!-- RESULT -->
  <section class="ui" data-estado="RESULT">
    <h1 class="cartel" id="resultadoTitulo">¡Sos una <span class="script">popstar</span>!</h1>
    <p class="kicker" id="resultadoMsg" hidden></p>
    <div id="resultadoRow">
      <div id="scoreBox">
        <div id="score">0</div>
        <p class="kicker">puntos</p>
        <p id="desglose"></p>
        <p id="resumenReacciones"></p>
      </div>
      <div id="qrMarco">
        <img id="qrResultado" alt="QR para descargar tu video" />
        <p class="hint">Escaneá para descargar tu video</p>
      </div>
    </div>
  </section>

  <script>
    import '../lib/pantalla.js';
  </script>
</Base>
